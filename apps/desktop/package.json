{
  "name": "@harniqo/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Harniqo desktop engineering entry",
  "author": "Harniqo contributors",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/main/main.js",
  "engines": { "node": "24.22.1" },
  "scripts": {
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@harniqo/client": "workspace:*",
    "oauth4webapi": "3.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.1",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
