    "/v1/organizations/{organization_id}/projects/{project_id}/runs/{run_id}/stream": {
      "parameters": [
        {
          "name": "organization_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Identifier"
          }
        },
        {
          "name": "project_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Identifier"
          }
        },
        {
          "name": "run_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Identifier"
          }
        }
      ],
      "get": {
        "operationId": "streamRunEvents",
        "security": [
          {
            "PlatformAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE frames: id is the persisted per-Run seq; data is an EventEnvelope JSON. Heartbeats carry no id. Last-Event-ID and after cannot conflict.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organization_id}/projects/{project_id}/artifacts/{artifact_id}/content": {
      "parameters": [
        {
          "name": "organization_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Identifier"
          }
        },
        {
          "name": "project_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Identifier"
          }
        },
        {
          "name": "artifact_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Identifier"
          }
        }
      ],
      "get": {
        "operationId": "downloadArtifact",
        "security": [
          {
            "PlatformAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "Range",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^bytes=[0-9]*-[0-9]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized complete content; recheck permission and revoke active stream within policy deadline.",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Authorized byte range.",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
